{
    "name": "presendoo-embed",
    "version": "1.3.1",
    "description": "Presendoo embed script for npm (typed) and CDN (plain JS).",
    "author": "Joren Lauryssen",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "unpkg": "dist/presendoo-embed.min.js",
    "jsdelivr": "dist/presendoo-embed.min.js",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "test:types": "tsc -p test/types/tsconfig.json",
        "test": "npm run build && npm run test:types && playwright test",
        "test:headed": "npm run build && npm run test:types && playwright test --headed",
        "prepublishOnly": "npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write 'src/**/*.{ts,tsx,js,json,css,md}'"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "http-server": "^14.1.1",
        "prettier": "^3.6.2",
        "rollup": "^4.0.0",
        "rollup-plugin-livereload": "^2.0.5",
        "rollup-plugin-serve": "^3.0.0",
        "rollup-plugin-typescript2": "^0.36.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.42.0"
    }
}
